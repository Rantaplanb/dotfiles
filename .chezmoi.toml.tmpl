sourceDir = "{{ .chezmoi.sourceDir }}"

[data]
    profile = "lpersonal"
    email = "user@example.com"
    name = "Lpersonal User"

# Future work:
# - add your own [age] section after generating a new recipient/keypair
# - keep Bitwarden integration dormant until you add your own token and secrets
[bitwardenSecrets]
    command = "{{ .chezmoi.sourceDir }}/bin/chezmoi-bws"

[diff]
    pager = "{{ .chezmoi.sourceDir }}/bin/chezmoi-diff-pager"

[edit]
    command = "cursor"
    args = ["--wait"]

#!/bin/bash
# Install packages from Brewfile
# Runs when Brewfile content changes
# Hash: {{ include "private_dot_config/brew/Brewfile" | sha256sum }}

{{- if ne .chezmoi.os "darwin" }}
exit 0
{{- end }}

set -euo pipefail

BREWFILE_PATH="{{ .chezmoi.sourceDir }}/private_dot_config/brew/Brewfile"

log_info() {
    printf '\033[1;34m==>\033[0m %s\n' "$*"
}

log_warning() {
    printf '\033[1;33mWarning:\033[0m %s\n' "$*" >&2
}

log_error() {
    printf '\033[1;31mError:\033[0m %s\n' "$*" >&2
}

append_skip_values() {
    local var_name="$1"
    shift

    local current_value="${!var_name:-}"
    local item

    for item in "$@"; do
        [[ -z "$item" ]] && continue
        case " $current_value " in
            *" $item "*) ;;
            *)
                current_value="${current_value:+$current_value }$item"
                ;;
        esac
    done

    export "$var_name=$current_value"
}

pre_tap_brewfile_repos() {
    local tap
    local installed_taps

    installed_taps="$(HOMEBREW_NO_AUTO_UPDATE=1 brew tap)"

    while IFS= read -r tap; do
        [[ -z "$tap" ]] && continue

        if grep -Fxq "$tap" <<<"$installed_taps"; then
            continue
        fi

        log_info "Tapping $tap..."
        if HOMEBREW_NO_AUTO_UPDATE=1 brew tap "$tap"; then
            installed_taps="${installed_taps:+$installed_taps"$'\n'"}$tap"
        else
            log_warning "Failed to tap $tap. Brewfile validation will report any affected packages."
        fi
    done < <(awk '$1=="tap" {gsub(/"/, "", $2); print $2}' "$BREWFILE_PATH")
}

require_available_brewfile_entries() {
    local formula
    local cask
    local unavailable_formulae=()
    local unavailable_casks=()

    while IFS= read -r formula; do
        [[ -z "$formula" ]] && continue
        if ! HOMEBREW_NO_AUTO_UPDATE=1 brew info --formula "$formula" >/dev/null 2>&1; then
            unavailable_formulae+=("$formula")
        fi
    done < <(awk '$1=="brew" {gsub(/"/, "", $2); print $2}' "$BREWFILE_PATH")

    while IFS= read -r cask; do
        [[ -z "$cask" ]] && continue
        if ! HOMEBREW_NO_AUTO_UPDATE=1 brew info --cask "$cask" >/dev/null 2>&1; then
            unavailable_casks+=("$cask")
        fi
    done < <(awk '$1=="cask" {gsub(/"/, "", $2); print $2}' "$BREWFILE_PATH")

    if [[ "${#unavailable_formulae[@]}" -eq 0 && "${#unavailable_casks[@]}" -eq 0 ]]; then
        return 0
    fi

    log_error "Brewfile validation failed."

    if [[ "${#unavailable_formulae[@]}" -gt 0 ]]; then
        log_error "Unavailable Homebrew formulae: ${unavailable_formulae[*]}"
    fi

    if [[ "${#unavailable_casks[@]}" -gt 0 ]]; then
        log_error "Unavailable Homebrew casks: ${unavailable_casks[*]}"
    fi

    log_error "Update the Brewfile or fix the required tap(s) before re-running chezmoi apply."
    exit 1
}

log_info "Installing packages from Brewfile..."

if ! command -v brew &>/dev/null; then
    log_info "Installing Homebrew..."
    /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
    eval "$(/opt/homebrew/bin/brew shellenv)"
fi

pre_tap_brewfile_repos
require_available_brewfile_entries

if [[ -t 0 && -t 1 ]]; then
    brew bundle --file="$BREWFILE_PATH"
else
    log_info "Non-interactive shell detected. Skipping Mac App Store installs during chezmoi apply."
    # Skip all MAS app IDs in Brewfile to avoid interactive App Store password prompts.
    append_skip_values HOMEBREW_BUNDLE_MAS_SKIP \
        937984704 \
        1352778147 \
        1452453066 \
        1635403801 \
        985367838 \
        6740142714 \
        1639306886
    # Skip casks that install signed .pkg payloads and prompt for sudo.
    append_skip_values HOMEBREW_BUNDLE_CASK_SKIP font-sf-pro karabiner-elements
    brew bundle --file="$BREWFILE_PATH"
    log_info "To install Mac App Store apps later, run this in an interactive terminal:"
    log_info "  brew bundle --file=\$HOME/.config/brew/Brewfile"
fi

log_info "Package installation complete!"

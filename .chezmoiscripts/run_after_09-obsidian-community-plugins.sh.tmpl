#!/bin/bash

{{- if ne .chezmoi.os "darwin" }}
exit 0
{{- end }}

set -euo pipefail

if ! command -v python3 &>/dev/null; then
    echo "Warning: skipping Obsidian community plugin bootstrap because python3 is missing" >&2
    exit 0
fi

python3 <<'PY'
from __future__ import annotations

import json
import sys
import urllib.error
import urllib.request
from pathlib import Path

VAULTS = [
    Path.home() / "dev/personal/golden-vault",
    Path.home() / "dev/personal/obsidian/secondbrain",
    Path.home() / "Documents/NotesOfTheGods",
]


def release_assets(repo: str, version: str, *, styles: bool = True) -> dict:
    base_url = f"https://github.com/{repo}/releases/download/{version}"
    spec = {
        "assets": {
            "main.js": f"{base_url}/main.js",
        }
    }

    if styles:
        spec["optional_assets"] = {
            "styles.css": f"{base_url}/styles.css",
        }

    return spec


PLUGINS = {
    "auto-note-mover": release_assets("farux/obsidian-auto-note-mover", "1.2.0", styles=False),
    "dashboard-navigator": release_assets("drbap/dashboard-navigator-for-obsidian", "10.0.0"),
    "dataview": release_assets("blacksmithgu/obsidian-dataview", "0.5.70"),
    "fold-properties-by-default": release_assets("tbergeron/obsidian-fold-properties-by-default", "1.0.8", styles=False),
    "homepage": release_assets("mirnovov/obsidian-homepage", "4.4.0"),
    "leader-hotkeys-obsidian": release_assets("tgrosinger/leader-hotkeys-obsidian", "0.2.1"),
    "obsidian-admonition": release_assets("ebullient/obsidian-admonition", "10.3.2"),
    "obsidian-excalidraw-plugin": release_assets("zsviczian/obsidian-excalidraw-plugin", "2.20.5"),
    "obsidian-git": release_assets("Vinzent03/obsidian-git", "2.38.2"),
    "obsidian-hider": release_assets("kepano/obsidian-hider", "1.6.1"),
    "obsidian-icon-folder": release_assets("FlorianWoelki/obsidian-iconize", "2.14.7"),
    "obsidian-kanban": release_assets("obsidian-community/obsidian-kanban", "2.0.51"),
    "obsidian-linter": release_assets("platers/obsidian-linter", "1.31.0"),
    "obsidian-relative-line-numbers": release_assets("nadavspi/obsidian-relative-line-numbers", "3.0.0"),
    "obsidian-style-settings": release_assets("obsidian-community/obsidian-style-settings", "1.0.9"),
    "obsidian-vimrc-support": release_assets("esm7/obsidian-vimrc-support", "0.10.2", styles=False),
    "omnisearch": release_assets("scambier/obsidian-omnisearch", "1.28.0"),
    "quick-tagger": release_assets("Gorkycreator/obsidian-quick-tagger", "2.2.4", styles=False),
    "settings-search": release_assets("javalent/settings-search", "1.3.10"),
    "table-editor-obsidian": release_assets("tgrosinger/advanced-tables-obsidian", "0.22.1"),
    "templater-obsidian": release_assets("SilentVoid13/Templater", "2.18.1"),
}


def read_json(path: Path):
    return json.loads(path.read_text(encoding="utf-8"))


def write_bytes(path: Path, data: bytes) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_bytes(data)


failures = []

for vault in VAULTS:
    obsidian_dir = vault / ".obsidian"
    community_plugins_path = obsidian_dir / "community-plugins.json"
    if not community_plugins_path.exists():
        continue

    try:
        enabled_plugins = set(read_json(community_plugins_path))
    except Exception as exc:  # pragma: no cover - runtime guard
        failures.append(f"{vault}: failed to parse community-plugins.json ({exc})")
        continue

    for plugin_id, spec in PLUGINS.items():
        if plugin_id not in enabled_plugins:
            continue

        plugin_dir = obsidian_dir / "plugins" / plugin_id
        lock_path = plugin_dir / ".dotfiles-plugin-lock.json"
        required_assets = spec["assets"]
        optional_assets = spec.get("optional_assets", {})
        desired_lock = {"assets": required_assets, "optional_assets": optional_assets}
        assets_present = all((plugin_dir / asset_name).exists() for asset_name in required_assets)

        if assets_present and lock_path.exists():
            try:
                if read_json(lock_path) == desired_lock:
                    continue
            except Exception:
                pass

        try:
            for asset_name, asset_url in required_assets.items():
                with urllib.request.urlopen(asset_url) as response:
                    write_bytes(plugin_dir / asset_name, response.read())

            for asset_name, asset_url in optional_assets.items():
                try:
                    with urllib.request.urlopen(asset_url) as response:
                        write_bytes(plugin_dir / asset_name, response.read())
                except urllib.error.URLError as exc:
                    print(f"Warning: could not install optional {asset_name} for {plugin_id} in {vault}: {exc}", file=sys.stderr)

            lock_path.write_text(json.dumps(desired_lock, indent=2), encoding="utf-8")
            print(f"Installed {plugin_id} into {vault}")
        except urllib.error.URLError as exc:
            missing_assets = [asset_name for asset_name in required_assets if not (plugin_dir / asset_name).exists()]
            if missing_assets:
                failures.append(
                    f"{vault}: failed to install {plugin_id} ({exc}); missing assets: {', '.join(missing_assets)}"
                )
            else:
                print(f"Warning: could not refresh {plugin_id} in {vault}: {exc}", file=sys.stderr)

if failures:
    for failure in failures:
        print(f"Error: {failure}", file=sys.stderr)
    sys.exit(1)
PY
